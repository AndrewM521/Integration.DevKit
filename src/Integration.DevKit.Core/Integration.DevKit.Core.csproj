    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>DevKit.Core</Title>
    <RootNamespace>Integration.DevKit.Core</RootNamespace>
    <Version>2.1.1.0</Version>
