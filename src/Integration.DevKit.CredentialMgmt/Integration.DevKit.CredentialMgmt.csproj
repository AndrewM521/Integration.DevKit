<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(DevKitTargetFrameworks)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>DevKit.CredentialMgmt</Title>
    <RootNamespace>Integration.DevKit.CredentialMgmt</RootNamespace>
    <Version>2.1.0.0</Version>
    <PackageId>Integration.DevKit.CredentialMgmt</PackageId>
    <PackageProjectUrl>https://www.nuget.org/packages/Integration.DevKit.CredentialMgmt</PackageProjectUrl>
  </PropertyGroup>

  <!-- DataProtection must match the consumer's ASP.NET Core major version to avoid shared-framework conflicts. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.33" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="8.0.33" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="9.0.22" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="9.0.22" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Integration.DevKit.CredentialMgmt.Contracts\Integration.DevKit.CredentialMgmt.Contracts.csproj" />
    <ProjectReference Include="..\Integration.DevKit.ThreadLocks\Integration.DevKit.ThreadLocks.csproj" />
  </ItemGroup>

</Project>
