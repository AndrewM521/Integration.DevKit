    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Title>DevKit.ProcessLauncher</Title>
    <RootNamespace>Integration.DevKit.ProcessLauncher</RootNamespace>
    <Version>3.0.0.0</Version>
    <PackageId>Integration.DevKit.ProcessLauncher</PackageId>
    <PackageProjectUrl>https://www.nuget.org/packages/Integration.DevKit.ProcessLauncher</PackageProjectUrl>
