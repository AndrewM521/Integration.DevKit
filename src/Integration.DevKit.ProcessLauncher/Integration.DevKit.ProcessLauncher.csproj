  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Integration.DevKit.Core\Integration.DevKit.Core.csproj" />
  </ItemGroup>

</Project>
