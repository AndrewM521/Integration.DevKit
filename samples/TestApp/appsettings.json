{
  "Logging": {
    "LogLevel": {
      "Default": "Debug"
    }
  },
  "Integration.DevKit": {
    "ApiClientManagement": {
      "Default_HttpTimeout_Seconds": 50,
      "Clients": {
        "TestClient": {
          "BaseUrl": "https://jsonplaceholder.typicode.com/",
          "MaxConcurrentRequests": 5,
          "DefaultHeaders": {
            "1": "1234"
          },
          "HttpTimeout_Seconds": 25
        }
      }
    },
    "SQLManagement": {
      "Clients": {
        "TestClient": {
          "ConnectionString": "ThisIsATestConnectionString",
          "UseSingleConnection": true
        }
      }
    },
    "TaskManagement": {
      "MaxConcurrentTasks": -1
    },
    "CredentialManagement": {
      "Provider": "File",
      "Options": {
        "ApplicationName": "TestApp2",
        "SecretsFolder": "Junk\\Secrets",
        "KeysFolder": "Junk\\Keys"
      }
    }
  }
}
