{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        { 
          "files": ["src/AndrewM5.DevKit.Core/*.csproj"], 
          "src": ".."
        }
      ],
      "dest": "api/core"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}",
          "api/core/*.{md,yml}"
        ],
        "exclude": [
          "_site/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appName": "AndrewM5.DevKit",
      "_appTitle": "AndrewM5.DevKit",
      "_enableSearch": true,
      "pdf": false
    }
  }
}